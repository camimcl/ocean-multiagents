# Copie para .env (PowerShell: Copy-Item .env.example .env). NUNCA faça commit do .env.

# Servidor oficial da equipe (troque o X pelo número da equipe). Local: http://127.0.0.1:8000
OCEAN_BASE_URL=https://t0X.beatbot.com.br
# conformance = treino (eventos fixos) | official = prova (eventos deslocados até ±12 ticks)
OCEAN_SCENARIO_MODE=conformance
# Teto de ticks por turno; o servidor para antes se algo acontecer (stop_on_events=true)
OCEAN_ADVANCE_TICKS_MAX=50
OCEAN_HTTP_TIMEOUT_S=60

# LLM opcional (a decisão final passa sempre pelas regras em código)
LLM_ENABLED=false
# groq (padrão, gratuito) | openrouter (cota paga pequena) | anthropic (chave do escritório)
LLM_PROVIDER=groq
# Vazio = modelo padrão do provedor (groq/openrouter: openai/gpt-oss-120b | anthropic: claude-haiku-5-5)
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=400
LLM_TIMEOUT_S=30
# Preencha SÓ a chave do provedor escolhido. Nunca faça commit do .env.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Observabilidade opcional
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
